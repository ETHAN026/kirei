# Serveur
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080,http://localhost:5173

# Base de données (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/coiffure_db?schema=public"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Admin (compte coiffeur créé au seed)
ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=ChangeMoi123!

# E-mail (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx  # App Password (16 caractères)
EMAIL_FROM="ULTRABARBER <votre-email@gmail.com>"

# Mobile Money (agrégateur - ex: Kkiapay / FedaPay)
PAYMENT_PROVIDER=stub
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
FEDAPAY_API_KEY=
