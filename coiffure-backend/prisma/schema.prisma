generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------
// SALON (paramètres de l'enseigne — un seul enregistrement en général)
// ---------------------------------------------------------------
model Salon {
  id          String   @id @default(uuid())
  nomEnseigne String
  adresse     String?
  telephone   String?
  email       String?
  logoUrl     String?
  dureeCreneauMinutes Int @default(30) // durée standard d'un créneau de RDV
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  indisponibilites Indisponibilite[]
  horaires         HoraireOuverture[]
}

// Plages d'ouverture hebdomadaires (0=Dimanche ... 6=Samedi)
model HoraireOuverture {
  id          String  @id @default(uuid())
  salonId     String
  salon       Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  jourSemaine Int
  heureDebut  String // format "HH:mm"
  heureFin    String // format "HH:mm"
  ferme       Boolean @default(false)

  @@index([salonId])
}

// ---------------------------------------------------------------
// ADMINISTRATEUR (coiffeur / gestionnaire — propriétaire du salon)
// ---------------------------------------------------------------
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nom          String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------
// ASSISTANT (membre du personnel géré par le coiffeur)
// ---------------------------------------------------------------
model Assistant {
  id           String   @id @default(uuid())
  nom          String
  prenom       String
  email        String   @unique
  telephone    String?
  passwordHash String
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rendezVous RendezVous[]
}

// ---------------------------------------------------------------
// CLIENT
// ---------------------------------------------------------------
model Client {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String
  telephone String
  adresse   String?
  createdAt DateTime @default(now())

  rendezVous RendezVous[]

  @@index([email])
  @@index([telephone])
}

// ---------------------------------------------------------------
// COUPE (catalogue de coiffures proposées par le coiffeur)
// ---------------------------------------------------------------
model Coupe {
  id                  String   @id @default(uuid())
  nom                 String
  description         String?
  prixFcfa            Int
  domicileDisponible  Boolean  @default(false) // cette coupe est-elle proposée à domicile ?
  prixDomicileFcfa    Int?     // prix à domicile pour CETTE coupe (remplace prixFcfa si domicile choisi)
  actif               Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  photos     Photo[]
  rendezVous RendezVous[]
}

// Photo d'une coupe — gérée indépendamment (ajout/suppression individuels), max 3 par coupe
model Photo {
  id        String   @id @default(uuid())
  coupeId   String
  coupe     Coupe    @relation(fields: [coupeId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([coupeId])
}

// ---------------------------------------------------------------
// RENDEZ-VOUS
// ---------------------------------------------------------------
// Cycle de vie :
// EN_ATTENTE -> VALIDE (accepté par le coiffeur) -> TERMINE (prestation faite + encaissée -> compte dans le CA)
//            -> REFUSE (refusé par le coiffeur)
//            -> ANNULE (annulé par le client ou le coiffeur)
enum StatutRendezVous {
  EN_ATTENTE
  VALIDE
  TERMINE
  REFUSE
  ANNULE
}

enum LieuPrestation {
  SALON
  DOMICILE
}

model RendezVous {
  id             String           @id @default(uuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  coupeId        String
  coupe          Coupe            @relation(fields: [coupeId], references: [id])
  assistantId    String?          // null = pris en charge par le coiffeur lui-même
  assistant      Assistant?       @relation(fields: [assistantId], references: [id])
  tarifApplique  Int // snapshot du prix appliqué (coupe, ou tarif fixe domicile) au moment de la réservation
  lieuPrestation LieuPrestation   @default(SALON)
  adresseDomicile String?         // requise si lieuPrestation = DOMICILE
  dateHeureDebut DateTime
  dateHeureFin   DateTime // = dateHeureDebut + salon.dureeCreneauMinutes, calculée à la création
  statut         StatutRendezVous @default(EN_ATTENTE)
  notesAdmin     String?
  dateCreation   DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([dateHeureDebut])
  @@index([statut])
  @@index([assistantId])
}

// ---------------------------------------------------------------
// INDISPONIBILITE (congés, pauses, fermetures)
// ---------------------------------------------------------------
model Indisponibilite {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dateDebut DateTime
  dateFin   DateTime
  motif     String?
  createdAt DateTime @default(now())

  @@index([dateDebut, dateFin])
}
